# Telegram bot tokeni (@BotFather dan olinadi)
BOT_TOKEN=123456789:AAExampleTokenHere

# PostgreSQL ulanish manzili
DATABASE_URL=postgresql://user:password@localhost:5432/sensitivity_pubg

# Admin Telegram user ID'lari, vergul bilan ajratilgan
ADMIN_IDS=111111111,222222222

# Ixtiyoriy: agar tashqi AI API ishlatilsa (masalan, AI adjustment uchun)
AI_API_KEY=

# Webhook rejimi (Railway/Render kabi platformalarda tavsiya etiladi)
USE_WEBHOOK=false
WEBHOOK_BASE_URL=https://your-app.up.railway.app
WEBHOOK_PATH=/webhook
WEB_SERVER_HOST=0.0.0.0
WEB_SERVER_PORT=8080

# Standart til: uz | ru | en
DEFAULT_LOCALE=uz

LOG_LEVEL=INFO

# Referral bonus (har bir taklif uchun ball)
REFERRAL_BONUS_POINTS=10

# Saqlash limiti
FREE_SAVED_PROFILES_LIMIT=3
PREMIUM_SAVED_PROFILES_LIMIT=50
